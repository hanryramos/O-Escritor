{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",

    "musical": {

      "admins": {
        ".read": "auth != null",
        ".write": "!data.exists() || root.child('musical/admins').child('k0').val() === auth.token.email"
      },

      "config": {
        ".read": "auth != null",
        ".write": "auth != null"
      },

      "tokens": {
        "$userId": {
          ".read": "auth != null",
          ".write": "auth.uid === $userId"
        }
      },

      "$col": {

        "perfil": {
          "$doc": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || newData.child('email').val() === auth.token.email || root.child('musical/admins').child('k0').val() === auth.token.email)"
          }
        },

        "preferencias": {
          "$doc": {
            ".read": "auth != null",
            ".write": "auth != null && (!data.exists() || newData.child('email').val() === auth.token.email || root.child('musical/admins').child('k0').val() === auth.token.email)"
          }
        },

        "$tabela": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}